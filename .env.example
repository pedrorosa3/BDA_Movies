# Copiar este ficheiro para .env e preencher com as credenciais reais:
#   cp .env.example .env

# ---------------------------
# MySQL
# ---------------------------
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=<password>
MYSQL_DB=bda_Group11

# ---------------------------
# MongoDB Atlas (opcional — se definido, tem prioridade sobre a ligação local)
# ---------------------------
#MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/

# ---------------------------
# MongoDB local (Docker)
# ---------------------------
MONGO_DB=bda_Group11
MONGO_USER=root
MONGO_PASS=<password>
MONGO_HOST=localhost
MONGO_PORT=27017
DB_NAME=bda_Group11

# ---------------------------
# Execução
# ---------------------------
LIMITED=True   # True = inserção parcial (20 000 registos) | False = dataset completo
N_RUNS=1       # Nº de execuções de cada query no benchmark do ScriptGoal4.py
